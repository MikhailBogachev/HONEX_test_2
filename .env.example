# Avito Parser — Environment Configuration
# Copy this file to .env and fill in values if needed.
# No secrets required for base operation (uses your own browser session).

# Avito region (default: moskva_i_mo)
AVITO_REGION=moskva_i_mo

# Headless mode (true/false). Default: false (more stable against detection)
HEADLESS=false

# Request delays (seconds)
MIN_DELAY=2
MAX_DELAY=3

# Output directory
OUTPUT_DIR=output
